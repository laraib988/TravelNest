# ============================================================
# TravelNest Frontend Environment Variables
# ============================================================

# Local/NestJS API base URL (used as fallback for some routes)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (service area map, geocoding, city autocomplete)
NEXT_PUBLIC_MAPBOX_API_TOKEN=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (AI travel planner translation / content)
GROQ_API_KEY=

# ============================================================
# GNews API (destination news feature)
# ------------------------------------------------------------
# Used by src/lib/newsService.ts to fetch destination-specific
# travel news on SSR destination pages.
#
# Get a free key at: https://gnews.io/
# Free tier ~100 requests/day. Results are cached locally in
# /data/news/[destination-slug].json for 24 hours to avoid
# wasting quota.
#
# If this key is missing/empty, the news section gracefully
# falls back to cached data or default placeholder cards —
# the page render is never broken.
# ============================================================
GNEWS_API_KEY=